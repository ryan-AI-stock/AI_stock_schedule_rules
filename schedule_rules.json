{
  "version": "2026.06.07",
  "timezone": "Asia/Taipei",
  "market": "TWSE",
  "calendar": {
    "source": "twse_holiday_schedule",
    "on_error": "should_run_false"
  },
  "manual_dispatch": {
    "bypass_gate": true,
    "force_generation": true,
    "ignore_existing_report": true
  },
  "scheduled_completion": {
    "authority": "google_drive_current_period_report",
    "skip_when_complete": true,
    "github_cache_is_secondary_only": true
  },
  "profiles": {
    "daily": {
      "period_type": "daily",
      "run_after": "15:00",
      "run_on": "trading_day",
      "retry_until_success": true
    },
    "weekly": {
      "period_type": "weekly",
      "run_after": "15:00",
      "run_on": "last_trading_day_of_week",
      "retry_until_next_trading_day": true
    },
    "monthly": {
      "period_type": "monthly",
      "run_after": "15:00",
      "run_on": "last_trading_day_of_month"
    },
    "quarterly": {
      "period_type": "quarterly",
      "run_after": "15:00",
      "run_on": "last_trading_day_of_quarter"
    }
  }
}
